rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isFriendChat(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lunaFriends/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/lunaFriends/$(chatId)).data.members;
    }

    match /lunaProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'nick', 'nickLower', 'bio', 'interests',
          'favorites', 'photo', 'mood', 'updatedAt'
        ]);
      allow delete: if isSelf(uid);
    }

    match /lunaFriendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'fromNick', 'toNick', 'status', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    match /lunaFriends/{friendshipId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/lunaFriendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/lunaFriendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/lunaFriendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.members
        && get(/databases/$(database)/documents/lunaFriendRequests/$(request.resource.data.requestId)).data.toUid in request.resource.data.members;
      allow update, delete: if false;
    }

    match /lunaChats/{chatId} {
      allow read: if isFriendChat(chatId);
      allow create: if isFriendChat(chatId)
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if isFriendChat(chatId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.members.size() == 2;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isFriendChat(chatId);
        allow create: if isFriendChat(chatId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['fromUid', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}